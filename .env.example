# ==========================================
# OmniRoute AI Gateway - Environment Config
# ==========================================

# Configurações de Servidor
PORT=20128
NODE_ENV=production

# Chave de Administração do Dashboard / API
# (Gere uma string segura para proteger seu painel e chamadas de API)
ADMIN_KEY=seu_token_admin_super_seguro_aqui

# Persistência de Dados
DATA_DIR=/app/data

# Opcional: Configurações de Cache Semântico / Embeddings
# O OmniRoute gerencia banco SQLite interno para cache semântico e memória vetorizada por padrão
